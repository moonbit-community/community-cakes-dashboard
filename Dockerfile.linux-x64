FROM denoland/deno:debian

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git libc6-dev nodejs unzip xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash -s nightly

ENV PATH="/root/.moon/bin:${PATH}"
ENV MOON_IGNORE_PREBUILD=1
ENV MOON_NO_WORKSPACE=1

RUN moon version --all && moon update

WORKDIR /workspace
